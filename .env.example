# ---------------------------------------------------------------------------
# Core runtime
# ---------------------------------------------------------------------------

# Pipeline executor. Use "langgraph" for the default graph workflow, or
# "pipeline" for the legacy sequential executor.
PIPELINE_ENGINE=langgraph

# Async SQLAlchemy database URL. The default stores SQLite data under ./data.
DATABASE_URL=sqlite+aiosqlite:///./data/vidgen.db

# Comma-separated frontend origins allowed by FastAPI CORS middleware.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173


# ---------------------------------------------------------------------------
# Local storage paths
# ---------------------------------------------------------------------------

# Temporary upload directory for project files and intermediate uploads.
UPLOAD_DIR=./data/uploads

# Root directory for user-imported and scanned material assets.
MATERIALS_ROOT=./materials

# Directory for generated material thumbnails.
THUMBNAILS_DIR=./data/thumbnails

# Directory for generated videos, keyframes, subtitles, and transient outputs.
GENERATED_DIR=./data/generated

# Directory for durable repository assets and delivered video files.
VIDEO_REPOSITORY_DIR=./data/video_repository


# ---------------------------------------------------------------------------
# Upload limits
# ---------------------------------------------------------------------------

# Maximum size, in MB, for general video/reference uploads.
MAX_UPLOAD_SIZE_MB=500

# Maximum size, in MB, for uploaded image files.
MAX_IMAGE_SIZE_MB=50

# Maximum size, in MB, for uploaded audio files.
MAX_AUDIO_SIZE_MB=100

# Maximum size, in MB, for timeline asset uploads.
MAX_TIMELINE_ASSET_SIZE_MB=500


# ---------------------------------------------------------------------------
# Qwen LLM, vision, TTS, memory, and RAG
# ---------------------------------------------------------------------------

# DashScope/Qwen API key. Leave empty to use mock/fallback paths where enabled.
QWEN_API_KEY=

# OpenAI-compatible Qwen API base URL.
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Main Qwen model for orchestration, planning, multimodal analysis, and QA.
QWEN_OMNI_MODEL=qwen3-omni-flash

# Qwen text-to-speech model used by the TTS service.
QWEN_TTS_MODEL=qwen3-tts-flash

# Enable Mem0 semantic memory. Requires QWEN_API_KEY and Qdrant availability.
MEM0_ENABLED=true

# Embedding model used by Mem0 and RAG retrieval.
MEM0_EMBEDDING_MODEL=text-embedding-v3


# ---------------------------------------------------------------------------
# Video generation providers
# ---------------------------------------------------------------------------

# Default image-to-video model selected by the pipeline.
# Supported values in the app are "seedance1.5-pro", "seedance2.0", and "kling".
VIDEO_GENERATION_MODEL=seedance1.5-pro

# WaveSpeed/Kling API key, used when the WaveSpeed provider is selected.
WAVESPEED_API_KEY=

# WaveSpeed API base URL.
WAVESPEED_API_URL=https://api.wavespeed.ai/api/v3

# Direct Kling API key, used as a fallback/alternative to WaveSpeed credentials.
KLING_API_KEY=

# Direct Kling API base URL. Leave empty unless using a direct Kling endpoint.
KLING_API_URL=

# Volcengine Ark API key for Seedance providers.
ARK_API_KEY=

# Volcengine Ark API base URL.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Seedance 1.5 Pro model identifier used through Volcengine Ark.
SEEDANCE_MODEL=doubao-seedance-1-5-pro-251215

# Seedance 2.0 model identifier used through Volcengine Ark.
SEEDANCE_20_MODEL=doubao-seedance-2-0-260128


# ---------------------------------------------------------------------------
# Optional generic LLM provider
# ---------------------------------------------------------------------------

# Reserved generic LLM API key for alternative provider integrations.
LLM_API_KEY=

# Reserved generic LLM API base URL for alternative provider integrations.
LLM_API_URL=


# ---------------------------------------------------------------------------
# Douyin OAuth and publishing
# ---------------------------------------------------------------------------

# Douyin website-app Client Key. Required to create the QR authorization URL.
DOUYIN_CLIENT_KEY=

# Douyin website-app Client Secret. Required to exchange OAuth code for tokens.
DOUYIN_CLIENT_SECRET=

# HTTPS callback URL registered in the Douyin Open Platform website app.
DOUYIN_REDIRECT_URI=https://your-domain.example/api/social-accounts/douyin/callback

# Default Douyin OAuth scopes requested during account authorization.
DOUYIN_DEFAULT_SCOPE=user_info,video.create


# ---------------------------------------------------------------------------
# Mock service switches
# ---------------------------------------------------------------------------

# Use the mock video analyzer instead of the real analyzer implementation.
USE_MOCK_ANALYZER=true

# Use the mock LLM service instead of calling Qwen.
USE_MOCK_LLM=true

# Use the mock video generator instead of external image-to-video providers.
USE_MOCK_GENERATOR=true

# Use the mock image compositor instead of the real compositor placeholder.
USE_MOCK_COMPOSITOR=true

# Use the mock lip-sync generator instead of the real lip-sync placeholder.
USE_MOCK_LIPSYNC=true

# Use the mock TTS service instead of Qwen TTS.
USE_MOCK_TTS=true

# Use the mock video editor instead of FFmpeg-backed editing.
USE_MOCK_VIDEO_EDITOR=true
